#include <iostream>

using namespace std;

bool isEven(int n);

int main() {
  // test, with num = 2
  if (isEven(2)) {
    cout << "Even" << endl;
  }
  else {
    cout << "Odd" << endl;
  } 
  
  
}

bool isEven(int n) {
  int even = n % 2;
  if (even == 0) {
    return true;
  }
  else {
    return false;
  }
}
